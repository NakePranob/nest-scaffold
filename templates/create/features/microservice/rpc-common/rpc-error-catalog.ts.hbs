    code: status.UNAUTHENTICATED,
    message: "Unauthorized",
  },
  FORBIDDEN: {
    code: status.PERMISSION_DENIED,
    message: "Forbidden",
  },
  NOT_FOUND: {
    code: status.NOT_FOUND,
