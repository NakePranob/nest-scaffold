import { ApiProperty } from '@nestjs/swagger';
import { ALL_ERROR_CODES } from '../../errors/app-error-catalog';
import type { AppErrorCode } from '../../errors/app-error-catalog';

export class ErrorResponseDto {
  @ApiProperty({ enum: ALL_ERROR_CODES, example: 'USER_NOT_FOUND' })
  code: AppErrorCode;

  @ApiProperty({ example: 'User not found' })
  message: string;

  @ApiProperty({
    nullable: true,
    oneOf: [{ type: 'array' }, { type: 'object' }],
    example: null,
  })
  errors: unknown[] | Record<string, unknown> | null;
}

export class ValidationErrorItemDto {
  @ApiProperty({ example: 'email' })
  field: string;

  @ApiProperty({ example: 'email must be an email' })
  message: string;
}

export class ValidationErrorResponseDto {
  @ApiProperty({ example: 'VALIDATION_ERROR' })
  code: string;

  @ApiProperty({ example: 'Validation failed' })
  message: string;

  @ApiProperty({ type: [ValidationErrorItemDto] })
  errors: ValidationErrorItemDto[] | null;
}
