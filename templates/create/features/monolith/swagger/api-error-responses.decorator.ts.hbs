import { applyDecorators } from '@nestjs/common';
import {
  ApiBadRequestResponse,
  ApiConflictResponse,
  ApiExtraModels,
  ApiForbiddenResponse,
  ApiInternalServerErrorResponse,
  ApiNotFoundResponse,
  ApiUnauthorizedResponse,
  getSchemaPath,
} from '@nestjs/swagger';
import {
  ErrorResponseDto,
  ValidationErrorResponseDto,
} from '../dto/error-response.dto';

// The `properties` overrides below are raw inline JSON-schema objects, not
// `@ApiProperty()` on a real class — there's no TS type for the swagger CLI
// plugin to infer from, so every property here needs an explicit `type` or
// codegen tools (e.g. orval) emit `unknown` for it. A bare `$ref` doesn't
// need this (see api-success-response.decorator.ts) since it already
// points at a named schema with its own type.

export function ApiValidationError() {
  return applyDecorators(
    ApiExtraModels(ValidationErrorResponseDto),
    ApiBadRequestResponse({
      description: 'Validation failed',
      schema: { $ref: getSchemaPath(ValidationErrorResponseDto) },
    }),
  );
}

export function ApiUnauthorizedError() {
  return applyDecorators(
    ApiExtraModels(ErrorResponseDto),
    ApiUnauthorizedResponse({
      description: 'Unauthorized',
      schema: {
        allOf: [
          { $ref: getSchemaPath(ErrorResponseDto) },
          {
            properties: {
              code: { type: 'string', example: 'UNAUTHORIZED' },
              message: { type: 'string', example: 'Unauthorized' },
            },
          },
        ],
      },
    }),
  );
}

export function ApiForbiddenError() {
  return applyDecorators(
    ApiExtraModels(ErrorResponseDto),
    ApiForbiddenResponse({
      description: 'Forbidden',
      schema: {
        allOf: [
          { $ref: getSchemaPath(ErrorResponseDto) },
          {
            properties: {
              code: { type: 'string', example: 'FORBIDDEN' },
              message: { type: 'string', example: 'Forbidden' },
            },
          },
        ],
      },
    }),
  );
}

export function ApiNotFoundError(
  code = 'NOT_FOUND',
  message = 'Resource not found',
) {
  return applyDecorators(
    ApiExtraModels(ErrorResponseDto),
    ApiNotFoundResponse({
      description: message,
      schema: {
        allOf: [
          { $ref: getSchemaPath(ErrorResponseDto) },
          {
            properties: {
              code: { type: 'string', example: code },
              message: { type: 'string', example: message },
            },
          },
        ],
      },
    }),
  );
}

export function ApiConflictError(code = 'CONFLICT', message = 'Conflict') {
  return applyDecorators(
    ApiExtraModels(ErrorResponseDto),
    ApiConflictResponse({
      description: message,
      schema: {
        allOf: [
          { $ref: getSchemaPath(ErrorResponseDto) },
          {
            properties: {
              code: { type: 'string', example: code },
              message: { type: 'string', example: message },
            },
          },
        ],
      },
    }),
  );
}

export function ApiInternalServerError() {
  return applyDecorators(
    ApiExtraModels(ErrorResponseDto),
    ApiInternalServerErrorResponse({
      description: 'Internal server error',
      schema: {
        allOf: [
          { $ref: getSchemaPath(ErrorResponseDto) },
          {
            properties: {
              code: { type: 'string', example: 'INTERNAL_ERROR' },
              message: { type: 'string', example: 'Internal server error' },
            },
          },
        ],
      },
    }),
  );
}

export function ApiDefaultErrors() {
  return applyDecorators(ApiValidationError(), ApiInternalServerError());
}

export function ApiProtectedErrors() {
  return applyDecorators(ApiUnauthorizedError(), ApiForbiddenError());
}
